\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces  Success probabilities of the pretty good measurement and pretty bad measurement for 1000 randomly generated pairs of qubit states with randomly chosen prior probabilities. The pretty good measurement always achieves a success probability greater than $1/2$, whereas the pretty bad measurement always achieves a success probability less than $1/2$. }}{97}{figure.caption.98}\protected@file@percent }
\newlabel{fig:ch4_PBM-pgm_vs_pbm_two_states}{{4.2}{97}{Success probabilities of the pretty good measurement and pretty bad measurement for 1000 randomly generated pairs of qubit states with randomly chosen prior probabilities. The pretty good measurement always achieves a success probability greater than $1/2$, whereas the pretty bad measurement always achieves a success probability less than $1/2$}{figure.caption.98}{}}
\newlabel{fig:ch4_PBM-pgm_vs_pbm_two_states@cref}{{[figure][2][4]4.2}{[1][96][]97}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.7}Application: Quantum anomaly detection/avoidance}{97}{section.4.7}\protected@file@percent }
\newlabel{sec:ch4_PBM-anomaly}{{4.7}{97}{Application: Quantum anomaly detection/avoidance}{section.4.7}{}}
\newlabel{sec:ch4_PBM-anomaly@cref}{{[section][7][4]4.7}{[1][96][]97}{}{}{}}
\citation{llorens2024quantum,skotiniotis2018identification}
\new@label@record{__tag_graphic.23}{{xpos}{9077797}{ypos}{28164296}{abspage}{118}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces  Success probabilities of the pretty good measurement and pretty bad measurement for 1000 randomly generated ensembles of six qubit states with randomly selected prior probabilities. For small values of $n$, $\mathcal  {P}_{\mathrm  {PGM}}$ appears to cluster around $\frac  {2}{n}$, while $\mathcal  {P}_{\mathrm  {PBM}}$ appears to cluster around $\frac  {n-2}{n(n-1)}$. The case $n=6$ is shown here. }}{98}{figure.caption.99}\protected@file@percent }
\newlabel{fig:ch4_PBM-pgm_vs_pbm_six_states}{{4.3}{98}{Success probabilities of the pretty good measurement and pretty bad measurement for 1000 randomly generated ensembles of six qubit states with randomly selected prior probabilities. For small values of $n$, $\PPGM $ appears to cluster around $\frac {2}{n}$, while $\PPBM $ appears to cluster around $\frac {n-2}{n(n-1)}$. The case $n=6$ is shown here}{figure.caption.99}{}}
\newlabel{fig:ch4_PBM-pgm_vs_pbm_six_states@cref}{{[figure][3][4]4.3}{[1][96][]98}{}{}{}}
\new@label@record{__tag_graphic.24}{{xpos}{8762158}{ypos}{24216808}{abspage}{119}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces  Probabilities for the quantum state discrimination task defined by $\ket {\psi _i} = \ket {0}^{\otimes (i-1)} \otimes \ket {\psi } \otimes \ket {0}^{\otimes (7-i)}$, where $\ket {\psi } = \gamma \ket {0} + \sqrt  {1-\gamma ^2}\ket {1}$ and $i\in \{1,\ldots  ,7\}$. While $\mathcal  {P}_{\mathrm  {PGM}}=\mathcal  {P}_{\mathrm  {Best}}$ for all values of $\gamma $, $\mathcal  {P}_{\mathrm  {PBM}}$ begins to depart from the worst success probability near $\gamma =0.4$. All four probabilities coincide at $\gamma =1$, since all the states are identical in this case; see Eq.~\eqref  {eq:ch4_PBM-allthesame}. }}{99}{figure.caption.100}\protected@file@percent }
\newlabel{fig:ch4_PBM-anomaly_7}{{4.4}{99}{Probabilities for the quantum state discrimination task defined by $\ket {\psi _i} = \ket {0}^{\otimes (i-1)} \otimes \ket {\psi } \otimes \ket {0}^{\otimes (7-i)}$, where $\ket {\psi } = \gamma \ket {0} + \sqrt {1-\gamma ^2}\ket {1}$ and $i\in \{1,\ldots ,7\}$. While $\PPGM =\Pbest $ for all values of $\gamma $, $\PPBM $ begins to depart from the worst success probability near $\gamma =0.4$. All four probabilities coincide at $\gamma =1$, since all the states are identical in this case; see Eq.~\eqref {eq:ch4_PBM-allthesame}}{figure.caption.100}{}}
\newlabel{fig:ch4_PBM-anomaly_7@cref}{{[figure][4][4]4.4}{[1][99][]99}{}{}{}}
\new@label@record{__tag_graphic.25}{{xpos}{8762158}{ypos}{20295897}{abspage}{120}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces  Given one of the equally likely states $\ket {\psi _i} = \ket {0}^{\otimes (i-1)} \otimes \ket {\psi } \otimes \ket {0}^{\otimes (7-i)}$, where $\ket {\psi } = \gamma \ket {0} + \sqrt  {1-\gamma ^2}\ket {1}$ and $i\in \{1,\ldots  ,7\}$, we plot the probability of successfully excluding the anomaly $\ket {\psi }$ using the PBM and the probability of successfully identifying $\ket {\psi }$ using the PGM. The probability $\mathcal  {P}_{\mathrm  {PGM}}$ decreases rapidly beginning near $\gamma =0.2$ and approaches the blind identification probability of $1/7$ at $\gamma =1$. In contrast, the exclusion success probability $1-\mathcal  {P}_{\mathrm  {PBM}}$ decreases more slowly and approaches the blind exclusion probability of $6/7$ at $\gamma =1$. As expected, the exclusion success probability is substantially greater than the identification success probability. }}{100}{figure.caption.101}\protected@file@percent }
\newlabel{fig:ch4_PBM-anomaly_7_success}{{4.5}{100}{Given one of the equally likely states $\ket {\psi _i} = \ket {0}^{\otimes (i-1)} \otimes \ket {\psi } \otimes \ket {0}^{\otimes (7-i)}$, where $\ket {\psi } = \gamma \ket {0} + \sqrt {1-\gamma ^2}\ket {1}$ and $i\in \{1,\ldots ,7\}$, we plot the probability of successfully excluding the anomaly $\ket {\psi }$ using the PBM and the probability of successfully identifying $\ket {\psi }$ using the PGM. The probability $\PPGM $ decreases rapidly beginning near $\gamma =0.2$ and approaches the blind identification probability of $1/7$ at $\gamma =1$. In contrast, the exclusion success probability $1-\PPBM $ decreases more slowly and approaches the blind exclusion probability of $6/7$ at $\gamma =1$. As expected, the exclusion success probability is substantially greater than the identification success probability}{figure.caption.101}{}}
\newlabel{fig:ch4_PBM-anomaly_7_success@cref}{{[figure][5][4]4.5}{[1][99][]100}{}{}{}}
