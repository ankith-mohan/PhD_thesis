\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces  We consider a sequence of $N$ states that begins in $\ket {0}$ and may switch to $\ket {+}$ at an unknown position. The optimal reward, corresponding to the optimal probability of identifying the location of the change point, is plotted as a function of $N$ for different values of the closeness parameter $\mu $. The reward stabilizes for large sequence lengths, and larger values of $\mu $ substantially improve the reward, as expected. }}{75}{figure.caption.81}\protected@file@percent }
\newlabel{fig:ch3_QSD-beta'_beta''_pi_4_1CP_mu}{{3.4}{75}{We consider a sequence of $N$ states that begins in $\ket {0}$ and may switch to $\ket {+}$ at an unknown position. The optimal reward, corresponding to the optimal probability of identifying the location of the change point, is plotted as a function of $N$ for different values of the closeness parameter $\mu $. The reward stabilizes for large sequence lengths, and larger values of $\mu $ substantially improve the reward, as expected}{figure.caption.81}{}}
\newlabel{fig:ch3_QSD-beta'_beta''_pi_4_1CP_mu@cref}{{[figure][4][3]3.4}{[1][74][]75}{}{}{}}
