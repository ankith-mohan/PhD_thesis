\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces  We consider the closer-the-better reward scheme with $\gamma = |\braket {\psi }{\phi }| = \cos (\theta )$ for $\theta \in \{\pi /8, \pi /4, 3\pi /8\}$, where $\ket {\psi } = \ket {0}$ and $\ket {\phi } = \cos (\theta )\ket {0} + \sin (\theta )\ket {1}$. Panel~(a) shows the reward Bob receives for the sequence $\ket {\psi }^{\otimes 50} \otimes \ket {\phi }^{\otimes 50}$ under this reward scheme. Panel~(b) shows the optimal reward function value as a function of $N$, the number of states sent. As the states become closer to one another, locating the change point becomes more difficult. However, the rewards are scaled so that more difficult settings correspond to larger rewards. }}{76}{figure.caption.83}\protected@file@percent }
\newlabel{fig:ch3_QSD-overall_1CP}{{3.5}{76}{We consider the closer-the-better reward scheme with $\gamma = |\braket {\psi }{\phi }| = \cos (\theta )$ for $\theta \in \{\pi /8, \pi /4, 3\pi /8\}$, where $\ket {\psi } = \ket {0}$ and $\ket {\phi } = \cos (\theta )\ket {0} + \sin (\theta )\ket {1}$. Panel~(a) shows the reward Bob receives for the sequence $\ket {\psi }^{\otimes 50} \otimes \ket {\phi }^{\otimes 50}$ under this reward scheme. Panel~(b) shows the optimal reward function value as a function of $N$, the number of states sent. As the states become closer to one another, locating the change point becomes more difficult. However, the rewards are scaled so that more difficult settings correspond to larger rewards}{figure.caption.83}{}}
