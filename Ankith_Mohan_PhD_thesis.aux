\@writefile{lof}{\contentsline {figure}{\numberline {1.3}{\ignorespaces  Alice prepares the state $\ket {\psi _x} = \ket {\psi _{x_1}} \otimes \cdots  \otimes \ket {\psi _{x_n}}$ and sends it to Bob. Bob's goal is to compute a Boolean function $f(x)$. Bob can either store all of his received states and then perform a joint measurement (left panel (a)) to obtain a guess $b$ for $f(x)$, or he can measure each of his received states as soon as it is received using predetermined local measurements to obtain a guess $y_i$ for $x_i$ which can be collectively used to guess $f(x)$ (right panel (b)). }}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:ch1_global_vs_greedy}{{1.3}{11}{Alice prepares the state $\ket {\psi _x} = \ket {\psi _{x_1}} \otimes \cdots \otimes \ket {\psi _{x_n}}$ and sends it to Bob. Bob's goal is to compute a Boolean function $f(x)$. Bob can either store all of his received states and then perform a joint measurement (left panel (a)) to obtain a guess $b$ for $f(x)$, or he can measure each of his received states as soon as it is received using predetermined local measurements to obtain a guess $y_i$ for $x_i$ which can be collectively used to guess $f(x)$ (right panel (b))}{figure.caption.17}{}}
\newlabel{fig:ch1_global_vs_greedy@cref}{{[figure][3][1]1.3}{[1][11][]11}{}{}{}}
